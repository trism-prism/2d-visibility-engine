# Interaction test, replayed through ImGui's input queue (see app/script.h).
# Window 1280x800, demo scene: 55 user walls, light at (610, 290).
wait 3
log
expect scene == demo
expect mode == grid
expect walls == 55
expect light_x == 610
expect light_y == 290
expect tour == off
expect light_hint == yes
expect detail == simple

# --- drag the light: press on the handle, move, release
save lx light_x
save poly0 poly_hash
wmove 610 290
down left
wmove 700 400
wmove 750 520
up left
wait 2
log
expect light_x != $lx
# the injected mouse position arrives pixel-rounded, so allow about a pixel (1 px = 1.8 world units)
expect light_x > 747.5
expect light_x < 752.5
expect light_y > 517.5
expect light_y < 522.5
expect walls == 55
expect poly_hash != $poly0
expect light_hint == no

# --- draw a wall: wall count +1 and the polygon changes
save poly1 poly_hash
wmove 900 560
down left
wmove 900 630
wmove 900 700
up left
wait 2
log
expect walls == 56
expect poly_hash != $poly1
expect status has Wall added

# --- zero-length wall (press and release without moving) is rejected
wmove 1300 600
down left
up left
wait 2
log
expect walls == 56
expect status has too short

# --- right-click deletes the wall just drawn
wmove 900 630
down right
up right
wait 2
log
expect walls == 55
expect status has Wall removed

# --- right-click on a boundary wall: nothing is deleted, the status line says so
wmove 800 0
down right
up right
wait 2
log
expect walls == 55
expect status has The outer walls can't be removed

# --- a user wall on the world edge (within a fraction of a pixel of the boundary wall) is deletable:
# user walls are picked before the boundary wall next to them. (The exact tie is tested further down.)
wmove 1 380
down left
wmove 1 560
up left
wait 2
expect walls == 56
wmove 1 470
wait 2
down right
up right
wait 2
log
expect walls == 55
expect status has Wall removed

# --- exact tie: a user wall drawn with Shift from corner to corner snaps onto the top boundary wall
# (same end points). The user wall is picked first, so one right-click removes it; the next click
# on the same spot reaches the boundary wall and is refused.
shift on
wmove 2 2
down left
wmove 1598 2
up left
shift off
wait 2
expect walls == 56
wmove 800 0
wait 2
down right
up right
wait 2
expect walls == 55
expect status has Wall removed
down right
up right
wait 2
expect walls == 55
expect status has The outer walls can't be removed

# --- clicking on the panel (empty area and a button) must not create a wall
save poly2 poly_hash
move 1100 100
down left
up left
wait 2
expect walls == 55
expect drawing == no
move @Reset
down left
up left
wait 2
log
expect status has Demo room loaded
expect walls == 55
expect light_x == 610

# --- a drag that starts on the canvas draws a wall even if it ends over the panel
wmove 1000 900
down left
move 1200 500
wait 2
expect drawing == yes
key Escape
expect drawing == no
up left
wait 2
expect walls == 55

# --- Tab switches mode; the scene and the light are untouched; outputs identical
set compare on
wait 3
save v0 vertices
save lx0 light_x
save h0 poly_hash
log
expect identical == yes
key Tab
log
expect mode == brute
expect identical == yes
expect vertices == $v0
expect walls == 55
expect light_x == $lx0
expect poly_hash == $h0
key Tab
expect mode == grid
expect identical == yes
set compare off

# --- overlays: O cycles off -> grid -> probe -> rays -> off
key O
expect overlay == grid
key O
expect overlay == probe
wmove 800 300
wait 3
log
expect probe_walls > 0
expect probe_cells > 0
key Tab
wait 3
log
expect mode == brute
expect probe_walls == 59
key Tab
key O
expect overlay == rays
key O
expect overlay == off

# --- probe overlay stays valid across scene changes in the frame the ray is picked
# (a stale probe index used to be possible after C / R / stress loads / mode switches)
set overlay probe
wmove 800 300
wait 3
expect probe_cells >= 0
expect probe_walls >= 1
key C
wait 2
expect walls == 0
expect probe_walls >= 1
key R
wait 2
expect walls == 55
expect probe_cells >= 0
key 1
wait 2
expect scene == scatter
expect probe_walls >= 1
key 2
wait 2
expect scene == maze
expect probe_cells >= 0
key Tab
wait 2
expect mode == brute
expect probe_walls == 1004
key 3
wait 2
expect scene == longwalls
expect probe_walls == 1004
key 4
wait 2
expect scene == cluster
expect probe_walls == 1004
key C
wait 2
expect probe_walls == 4
key Tab
wait 2
expect mode == grid
key R
wait 2
expect walls == 55

# --- legend: the two-colour row is dimmed while both sides of the probed ray end at the same wall
# (demo room, light at 610,290, grid mode, probe overlay)
wmove 1100 300
wait 4
save pplus probe_tplus
expect probe_tminus == $pplus
expect legend_pair == dim
wmove 900 200
wait 4
save pplus probe_tplus
expect probe_tminus != $pplus
expect legend_pair == full
set overlay off
wait 2

# --- C clears, R resets
key C
expect walls == 0
key R
expect walls == 55
expect light_x == 610

# --- stress scenes via 1-4: at least 1000 walls each
key 1
wait 4
log
expect scene == scatter
expect walls >= 1000
key 2
wait 4
log
expect scene == maze
expect walls >= 1000
key 3
wait 4
log
expect scene == longwalls
expect walls >= 1000
key 4
wait 4
log
expect scene == cluster
expect walls >= 1000
key R
expect walls == 55

# =====================================================================================
# UI refresh checks. State here: demo room, Grid method, overlay off, Simple level.
# =====================================================================================
key R
wait 3
set overlay off
set mode grid
wait 3

# --- Simple / Engine details toggle; Simple fits at 1280x800 without scrolling
expect detail == simple
expect panel_overflow == no
move @Engine details
down left
up left
wait 4
expect detail == details
move @Simple
down left
up left
wait 4
expect detail == simple
expect panel_overflow == no

# --- work meter on the demo room, Grid active: baseline count is exactly rays x walls, grid count is
# the measured wall tests
expect scene == demo
save prod rays_x_walls
expect meter_baseline == $prod
save rr rays
save ww walls_total
expect meter_rays == $rr
expect meter_walls == $ww
expect meter_source == measured
save wtg wall_tests
expect meter_grid == $wtg
expect meter_verdict has of the work here
print rays walls_total meter_rays meter_walls meter_baseline meter_grid meter_source meter_verdict query_median_us
save g meter_grid
save lxm light_x
save lym light_y
# --- Baseline active: baseline count == measured wall tests == rays x walls; the grid number comes from
# the untimed extra pass and equals what Grid mode reports for the same light
key Tab
wait 4
expect mode == brute
save prodB rays_x_walls
expect meter_baseline == $prodB
expect wall_tests == $prodB
expect meter_source == extra_pass
expect meter_grid == $g
expect light_x == $lxm
expect light_y == $lym
print rays walls_total meter_baseline meter_grid meter_source meter_verdict
key Tab
wait 4
expect mode == grid
expect wall_tests == $g
expect meter_grid == $g
print rays walls_total meter_baseline meter_grid meter_source

# --- the same on a 1000-wall scene, driven by the scene card
move @Scattered walls
down left
up left
wait 5
expect scene == scatter
save prod1 rays_x_walls
save wt1 wall_tests
expect meter_baseline == $prod1
expect meter_grid == $wt1
save g2 meter_grid
save prod2 meter_baseline
key Tab
wait 5
expect wall_tests == $prod2
expect meter_source == extra_pass
expect meter_grid == $g2
expect meter_grid < $prod2
print scene rays walls_total meter_baseline meter_grid meter_source meter_verdict
key Tab
wait 3

# --- slow-scene note: Long walls under "Check every wall"
set mode brute
key 3
wait 4
expect scene == longwalls
expect slow_note == yes
expect slow_ms > 30
expect slow_text has Slow with
expect meter_source == skipped
expect meter_grid == unknown
# the tallest Simple panel (slow note plus "not measured") still fits 1280 x 800 with room to spare
expect panel_overflow == no
expect panel_slack > 15
save prod3 rays_x_walls
expect meter_baseline == $prod3
print scene slow_ms slow_text meter_baseline meter_source meter_verdict
# the note is about Baseline, so it is also shown while the grid is active
set mode grid
wait 4
expect slow_note == yes
# the note must not push the Simple panel into scrolling (Grid: one note, Baseline: note + advice)
expect panel_overflow == no
set mode brute
wait 4
expect panel_overflow == no
set mode grid
key 4
wait 5
expect scene == cluster
expect panel_overflow == no
set mode brute
key R
wait 4
expect slow_note == no
set mode grid
wait 3

# --- plain-language captions come from real data
set overlay grid
wait 3
expect caption has squares. Brighter squares were crossed by more rays
set overlay probe
wmove 800 300
wait 3
expect caption has This one crossed
expect caption has walls.
set mode brute
wait 3
expect caption has This one had to test all 59 walls
set mode grid
set overlay rays
wait 3
expect caption has rays, one aimed at each direction
set overlay off
wait 2

# --- cursors: hand over the light, crosshair where a click starts a wall, arrow over the panel
wmove 610 290
wait 2
expect cursor == hand
wmove 300 700
wait 2
expect cursor == cross
move 1100 100
wait 2
expect cursor == arrow

# --- tour: not auto-started under --script, opened by the button, Next / Back / Close
expect tour == off
move @Take the tour
down left
up left
wait 4
expect tour == on
expect tour_step == 1
expect scene == demo
expect mode == grid
move @Next
down left
up left
wait 3
expect tour_step == 2
move @Next
down left
up left
wait 3
expect tour_step == 3
expect overlay == probe
move @Next
down left
up left
wait 3
expect tour_step == 4
expect mode == brute
expect overlay == probe
move @Back
down left
up left
wait 3
expect tour_step == 3
expect mode == grid
move @Next
down left
up left
wait 3
expect tour_step == 4
# a click on the tour card never creates a wall
save wcard walls
move @tour card
down left
up left
wait 3
expect walls == $wcard
expect drawing == no
expect tour == on
move @Next
down left
up left
wait 5
expect tour_step == 5
expect scene == scatter
expect walls == 1000
expect mode == grid
move @Next
down left
up left
wait 5
expect tour_step == 6
expect scene == cluster
move @Next
down left
up left
wait 3
expect tour == off
# Close button and Esc
move @Take the tour
down left
up left
wait 4
expect tour == on
expect scene == demo
move @Close
down left
up left
wait 3
expect tour == off
set tour on
wait 3
expect tour == on
key Escape
wait 2
expect tour == off
# the world is not covered by the tour card, and the panel still works with the tour closed
expect panel_overflow == no
quit
